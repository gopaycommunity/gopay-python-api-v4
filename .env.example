# Sandbox eshop credentials for the examples and `pytest -m e2e`. Copy to .env (ignored by
# git) and export, e.g. `set -a; . ./.env; set +a`. Never commit real values.
GOPAY_PAYMENTS_V4_CLIENT_ID=
GOPAY_PAYMENTS_V4_CLIENT_SECRET=
GOPAY_PAYMENTS_V4_GOID=
# Optional, for the e2e tests: a gateway other than the public sandbox.
GOPAY_PAYMENTS_V4_BASE_URL=
